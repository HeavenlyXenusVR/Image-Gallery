:root {
  color-scheme: dark;
  --bg: #101318;
  --panel: #181d24;
  --panel-2: #202832;
  --control: #10151b;
  --button: #222a34;
  --text: #f5f7fb;
  --muted: #9ba8b7;
  --line: #303945;
  --accent: #37c9a7;
  --accent-2: #e0b34b;
  --danger: #ff6b6b;
  --shadow: 0 20px 80px rgba(0, 0, 0, 0.32);
  --site-background-image: none;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

@keyframes brandGlow {
  0%, 100% { box-shadow: 0 0 0 rgba(55, 201, 167, 0); }
  50% { box-shadow: 0 0 26px rgba(55, 201, 167, 0.32); }
}

@keyframes softPop {
  from { opacity: 0; transform: translateY(-4px) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes panelRise {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes cardIn {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes backdropFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes modalEnter {
  from { opacity: 0; transform: translateY(14px) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes progressShimmer {
  from { transform: translateX(-110%); }
  to { transform: translateX(110%); }
}

@keyframes processingPulse {
  from { filter: saturate(1); }
  to { filter: saturate(1.35) brightness(1.15); }
}

@keyframes uploadButtonPulse {
  from { box-shadow: 0 0 0 rgba(55, 201, 167, 0); }
  to { box-shadow: 0 0 22px rgba(55, 201, 167, 0.34); }
}

@keyframes selectedPulse {
  0%, 100% { box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 36%, transparent), 0 18px 42px rgba(0, 0, 0, 0.24); }
  50% { box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 18%, transparent), 0 20px 48px rgba(0, 0, 0, 0.28); }
}

@keyframes skeletonShimmer {
  from { background-position: 160% 0; }
  to { background-position: -160% 0; }
}

@keyframes trayLift {
  from { opacity: 0; transform: translate(-50%, 16px) scale(0.98); }
  to { opacity: 1; transform: translate(-50%, 0) scale(1); }
}

@keyframes dropPulse {
  from { border-color: var(--accent); }
  to { border-color: var(--accent-2); }
}

@keyframes toastIn {
  from { opacity: 0; transform: translate(-50%, 10px); }
  to { opacity: 1; transform: translate(-50%, 0); }
}

body[data-theme="light"] {
  color-scheme: light;
  --bg: #f6f4ef;
  --panel: #ffffff;
  --panel-2: #ece7dd;
  --control: #ffffff;
  --button: #f1eee8;
  --text: #171a1d;
  --muted: #65717d;
  --line: #d8d0c3;
  --shadow: 0 18px 60px rgba(58, 48, 36, 0.16);
}

body[data-density="compact"] .gallery-grid { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
body[data-density="compact"] .media-info { padding: 10px; gap: 8px; }
body[data-density="wide"] .gallery-grid { grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
body[data-reduce-motion="1"] * { scroll-behavior: auto !important; transition: none !important; animation: none !important; }
body.panel-low-power * { scroll-behavior: auto !important; transition: none !important; animation: none !important; }
body[data-blur-videos="1"] .media-preview video { filter: blur(6px); }

* { box-sizing: border-box; }
[hidden] { display: none !important; }
html, body { max-width: 100%; overflow-x: hidden; }
body {
  margin: 0;
  position: relative;
  isolation: isolate;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
}

body::before,
body::after {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
}

body::before {
  z-index: -2;
  opacity: 0;
  background-image: var(--site-background-image);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  filter: saturate(1.05) contrast(1.04) brightness(0.58);
  transform: scale(1.03);
  transition: opacity 900ms ease, filter 900ms ease;
}

body[data-background-ready="1"]::before {
  opacity: 1;
}

body::after {
  z-index: -1;
  background:
    linear-gradient(180deg, rgba(7, 11, 16, 0.48), rgba(7, 11, 16, 0.78)),
    linear-gradient(135deg, rgba(55, 201, 167, 0.12), transparent 36%),
    linear-gradient(315deg, rgba(224, 179, 75, 0.1), transparent 34%);
}

button, input, select, textarea, .button-link {
  font: inherit;
}

button, .button-link {
  border: 1px solid var(--line);
  background: var(--button);
  color: var(--text);
  min-height: 40px;
  border-radius: 7px;
  padding: 0 14px;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  gap: 6px;
  line-height: 1.15;
  white-space: normal;
}

button, .button-link, .field input, .field select, .field textarea, .media-card, .collection-card, .studio-item, .mini-media, .avatar, .status-pill, .tag-cloud button {
  transition: transform 160ms ease, border-color 160ms ease, background 160ms ease, color 160ms ease, box-shadow 160ms ease, opacity 160ms ease;
}
button:hover, .button-link:hover { border-color: var(--accent); transform: translateY(-1px); }
button:active, .button-link:active { transform: translateY(0) scale(0.98); }
button:focus-visible, .button-link:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
  outline: 2px solid color-mix(in srgb, var(--accent) 70%, white);
  outline-offset: 2px;
}
.primary { background: var(--accent); color: #07110f; border-color: transparent; font-weight: 800; }
.icon-button { width: 40px; padding: 0; }
.text-button {
  min-height: 0;
  border: 0;
  background: transparent;
  color: var(--accent);
  padding: 0;
  display: inline;
  font-weight: 700;
}
.text-button.strong { color: var(--text); font-size: 1rem; }

.topbar {
  height: 72px;
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--line);
  background: rgba(16, 19, 24, 0.86);
  backdrop-filter: blur(18px);
  position: sticky;
  top: 0;
  z-index: 10;
}

.brand {
  color: var(--text);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 900;
}

.brand-mark {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  background: var(--accent);
  color: #07110f;
  border-radius: 8px;
  animation: brandGlow 4.8s ease-in-out infinite;
}

.topbar-actions { display: flex; align-items: center; gap: 10px; }
.status-pill {
  min-height: 32px;
  display: inline-flex;
  align-items: center;
  padding: 0 10px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--muted);
}
.status-pill:not([hidden]) { animation: softPop 220ms ease-out; }

.layout {
  width: min(1500px, calc(100vw - 32px));
  margin: 28px auto;
  display: grid;
  grid-template-columns: 292px minmax(0, 1fr);
  gap: 24px;
}
.content { min-width: 0; }

.sidebar {
  align-self: start;
  position: sticky;
  top: 96px;
}

.sidebar-block, .stats-grid, .modal-shell {
  background: rgba(24, 29, 36, 0.94);
  border: 1px solid var(--line);
  border-radius: 8px;
  box-shadow: var(--shadow);
}
.sidebar-block, .stats-grid { animation: panelRise 360ms ease both; }

.sidebar-block { padding: 16px; display: grid; gap: 14px; }
.advanced-filters {
  margin-top: 16px;
}
.advanced-filters summary {
  cursor: pointer;
  font-weight: 800;
}
.advanced-filters[open] summary {
  color: var(--accent);
}
.compact-fields {
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.tag-panel { margin-top: 16px; }
.side-title-row, .section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.side-title-row button { min-height: 30px; font-size: 0.8rem; }
.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.tag-cloud button {
  min-height: 30px;
  border-radius: 999px;
  font-size: 0.84rem;
  padding: 0 10px;
}
.tag-cloud span { color: var(--muted); }
.field { display: grid; gap: 7px; color: var(--muted); font-size: 0.9rem; }
.field input, .field select, .field textarea {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 7px;
  background: var(--control);
  color: var(--text);
  min-height: 42px;
  padding: 10px 12px;
}
.field input:focus, .field select:focus, .field textarea:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
}
.field textarea { resize: vertical; }

.stats-grid {
  margin-top: 16px;
  padding: 12px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.stats-grid div {
  min-height: 78px;
  background: var(--panel-2);
  border-radius: 7px;
  padding: 12px;
  display: grid;
  align-content: center;
  gap: 4px;
}
.stats-grid strong { font-size: 1.35rem; }
.stats-grid span, .muted { color: var(--muted); }

.account-card {
  margin-top: 16px;
  padding: 14px;
  display: flex;
  gap: 12px;
  align-items: center;
  background: rgba(24, 29, 36, 0.94);
  border: 1px solid var(--line);
  border-radius: 8px;
}

.account-card p { margin: 4px 0 0; }
.account-card button {
  margin-top: 8px;
  padding: 7px 10px;
  font-size: 0.78rem;
}
.account-card .account-profile-trigger {
  margin-top: 0;
  cursor: pointer;
}
.account-card .account-profile-trigger:hover,
.account-card .account-profile-trigger:focus-visible {
  color: var(--accent);
}
.account-card .avatar.account-profile-trigger {
  padding: 0;
}

.avatar {
  width: 48px;
  height: 48px;
  flex: 0 0 auto;
  border-radius: 50%;
  border: 2px solid var(--accent);
  background: var(--panel-2);
  display: grid;
  place-items: center;
  color: var(--text);
  font-weight: 900;
  overflow: hidden;
  padding: 0;
}

.avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar.tiny {
  width: 32px;
  height: 32px;
  font-size: 0.72rem;
}

.avatar.large {
  width: 84px;
  height: 84px;
  font-size: 1.3rem;
}

.content-head {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
}
.discover-hero-shell {
  padding: 22px;
  border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--line));
  border-radius: 24px;
  background:
    radial-gradient(circle at top left, color-mix(in srgb, var(--accent) 20%, transparent), transparent 38%),
    linear-gradient(145deg, color-mix(in srgb, var(--panel) 92%, black), color-mix(in srgb, var(--panel-2) 78%, black));
  box-shadow: var(--shadow);
}
.content-head h1 { font-size: clamp(2rem, 3vw, 3.25rem); line-height: 1; margin: 0; letter-spacing: 0; }
.content-head p { margin: 8px 0 0; }
.discover-hero-note {
  max-width: 280px;
  padding: 16px 18px;
  border-radius: 18px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.03);
}
.discover-hero-note strong {
  display: block;
  margin-bottom: 8px;
  font-size: 0.94rem;
}
.discover-hero-note p { margin: 0; }
.content-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8px;
}
.active-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: -6px 0 16px;
}
.active-filters button {
  min-height: 32px;
  border-radius: 999px;
  padding: 0 11px;
  font-size: 0.84rem;
  background: rgba(55, 201, 167, 0.1);
  border-color: rgba(55, 201, 167, 0.45);
}
.active-filters .clear-all {
  background: rgba(255, 107, 107, 0.1);
  border-color: rgba(255, 107, 107, 0.45);
  color: #ffd2d2;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 18px;
  max-width: 100%;
  overflow-x: clip;
  align-items: start;
}

.media-card {
  margin: 0;
  width: 100%;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 40%),
    linear-gradient(180deg, color-mix(in srgb, var(--panel) 94%, black), color-mix(in srgb, var(--panel-2) 88%, black));
  border: 1px solid color-mix(in srgb, var(--accent) 14%, var(--line));
  border-radius: 22px;
  overflow: hidden;
  animation: cardIn 360ms ease both;
  display: grid;
  grid-template-rows: auto 1fr;
}
.media-card:hover {
  transform: translateY(-5px);
  border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
  box-shadow: 0 28px 56px rgba(0, 0, 0, 0.28);
}
.media-card.is-compared {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 42%, transparent), 0 18px 42px rgba(0, 0, 0, 0.24);
  animation: selectedPulse 1.9s ease-in-out infinite;
}
.skeleton-card {
  animation-delay: var(--delay, 0ms);
  pointer-events: none;
}
.skeleton-preview {
  aspect-ratio: 4 / 5;
  background: linear-gradient(100deg, var(--panel-2) 0 30%, color-mix(in srgb, var(--panel-2) 70%, white) 45%, var(--panel-2) 60% 100%);
  background-size: 220% 100%;
  animation: skeletonShimmer 1.4s ease-in-out infinite;
}
.skeleton-line,
.skeleton-actions span {
  display: block;
  min-height: 14px;
  border-radius: 999px;
  background: linear-gradient(100deg, var(--panel-2) 0 30%, color-mix(in srgb, var(--panel-2) 70%, white) 45%, var(--panel-2) 60% 100%);
  background-size: 220% 100%;
  animation: skeletonShimmer 1.4s ease-in-out infinite;
}
.skeleton-line.strong {
  width: 72%;
  min-height: 18px;
}
.skeleton-line:not(.strong) {
  width: 48%;
}
.skeleton-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.media-preview {
  display: block;
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 5;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: #0b0f14;
  overflow: hidden;
}
.media-preview img, .media-preview video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 260ms ease, filter 260ms ease, opacity 180ms ease;
}
.media-card:hover .media-preview img,
.media-card:hover .media-preview video {
  transform: scale(1.025);
}
.adult-card { border-color: rgba(255, 184, 76, 0.42); }
.adult-badge {
  display: inline-flex;
  align-items: center;
  min-height: 22px;
  margin-right: 8px;
  padding: 0 7px;
  border-radius: 999px;
  background: rgba(255, 184, 76, 0.16);
  color: #ffd28c;
  border: 1px solid rgba(255, 184, 76, 0.38);
  font-size: 0.75rem;
  vertical-align: middle;
}
.adult-blur {
  display: block;
  filter: blur(12px);
  transform: scale(1.02);
}
.adult-overlay {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 16px;
  background: rgba(5, 7, 10, 0.42);
  color: #fff2d8;
  font-weight: 700;
  text-align: center;
}
.locked-preview {
  min-height: 100%;
  display: grid;
  place-items: center;
  gap: 4px;
  color: #ffe0a8;
  background: repeating-linear-gradient(135deg, #10151b 0 14px, #171d24 14px 28px);
}
.locked-preview strong { font-size: 2rem; }
.locked-preview span { color: var(--muted); }
.media-info { padding: 16px; display: grid; gap: 12px; align-content: start; }
.media-info h2 { margin: 0; font-size: 1.02rem; line-height: 1.25; }
.media-info p { margin: 4px 0 0; }
.media-kicker-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.media-kicker {
  min-height: 28px;
  display: inline-flex;
  align-items: center;
  padding: 0 10px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.03);
  color: #f4f8ff;
  font-size: 0.76rem;
  font-weight: 700;
}
.media-kicker.subtle {
  color: var(--muted);
  background: rgba(255, 255, 255, 0.02);
}
.media-card-head { align-items: start; }
.media-copy { min-width: 0; }
.media-copy h2 { font-size: 1.08rem; }
.author-row, .profile-row, .profile-mini, .comment-head {
  display: flex;
  align-items: center;
  gap: 10px;
}
.profile-row { align-items: end; }
.grow { flex: 1 1 auto; }
.metric-row, .card-actions, .action-row, .modal-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}
.metric-row { color: var(--muted); font-size: 0.82rem; }
.card-actions button, .card-actions a { min-height: 34px; font-size: 0.86rem; }
.tag-row.compact { gap: 6px; }
.tag-row.compact span {
  min-height: 24px;
  padding: 0 8px;
  font-size: 0.74rem;
}

.gallery-pagination {
  margin: 8px 0 18px;
  padding: 12px 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
}
.gallery-pagination button { min-width: 112px; }
.gallery-pagination span { min-width: 90px; text-align: center; }

.empty-state {
  border: 1px dashed var(--line);
  border-radius: 8px;
  min-height: 260px;
  display: grid;
  place-content: center;
  text-align: center;
  color: var(--muted);
}

.modal {
  border: 0;
  padding: 0;
  background: transparent;
  color: var(--text);
  width: min(720px, calc(100vw - 24px));
}
.modal::backdrop { background: rgba(0, 0, 0, 0.74); backdrop-filter: blur(8px); animation: backdropFade 160ms ease both; }
.modal-shell { padding: 18px; display: grid; gap: 14px; }
dialog[open] .modal-shell { animation: modalEnter 220ms ease-out both; }
.modal-shell.wide { width: min(760px, calc(100vw - 24px)); }
.modal-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.modal-head h2 { margin: 0; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.collection-form {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) auto auto;
  gap: 10px;
  align-items: center;
}
.collection-form input {
  min-height: 42px;
  border: 1px solid var(--line);
  border-radius: 7px;
  background: var(--control);
  color: var(--text);
  padding: 0 12px;
}
.collection-form label {
  color: var(--muted);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.collection-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 12px;
}
.collection-card {
  border: 1px solid var(--line);
  background: var(--panel-2);
  border-radius: 8px;
  overflow: hidden;
}
.collection-card:hover, .studio-item:hover, .mini-media:hover {
  transform: translateY(-2px);
  border-color: color-mix(in srgb, var(--accent) 42%, var(--line));
}
.collection-cover {
  width: 100%;
  min-height: 128px;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: #0b0f14;
}
.collection-cover img {
  width: 100%;
  height: 128px;
  object-fit: cover;
  display: block;
}
.collection-card > div { padding: 12px; }
.collection-card h3, .studio-item h3 { margin: 0 0 6px; }
.saved-views-list {
  display: grid;
  gap: 10px;
}
.saved-view-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--panel-2);
}
.saved-view-card h3 {
  margin: 0 0 4px;
}
.saved-view-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8px;
}
.upload-queue {
  display: grid;
  gap: 8px;
}
.upload-queue-item {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 4px 10px;
  align-items: center;
  padding: 10px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--panel-2);
  animation: softPop 180ms ease-out both;
}
.upload-queue-item strong,
.upload-queue-item span {
  overflow-wrap: anywhere;
}
.upload-queue-item span {
  color: var(--muted);
  font-size: 0.84rem;
}
.upload-queue-item em {
  grid-row: 1 / span 2;
  grid-column: 2;
  color: var(--accent);
  font-style: normal;
  font-weight: 800;
}
.upload-queue-item.is-active {
  border-color: var(--accent);
  animation: selectedPulse 1.2s ease-in-out infinite;
}
.mini-media-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 10px;
}
